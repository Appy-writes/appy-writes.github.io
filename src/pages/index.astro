---
import { getCollection } from "astro:content";
import CTASection from "../components/CTASection.astro";
import Hero from "../components/Hero.astro";
import NicheGrid from "../components/NicheGrid.astro";
import ProofOfWork from "../components/ProofOfWork.astro";
import WorkCard from "../components/WorkCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { siteData } from "../data/site";
import { sortWorkEntries, withBase } from "../utils/content";

const allWork = sortWorkEntries(await getCollection("work"), "featured");
const featuredWork = allWork.filter((entry) => entry.data.featured).slice(0, 6);
const hero = siteData.heroOptions[siteData.selectedHeroOption];
const stepPalette = [
  { base: "#8f4c31", soft: "#bf876b" },
  { base: "#9a5c40", soft: "#c18b71" },
  { base: "#a86b4d", soft: "#cb9a7e" },
  { base: "#7a5d50", soft: "#a88879" },
  { base: "#6c4f43", soft: "#97776a" }
];
---

<BaseLayout
  title="Content Strategist, SEO Writer, Editor"
  description="Lead-generating portfolio site for Atrayee Banerjee, a content strategist, SEO writer, and editor serving SaaS, B2B tech, agencies, and service brands."
>
  <Hero
    headline={hero.headline}
    subheadline={hero.subheadline}
    primaryHref={withBase("/work/")}
    secondaryHref={withBase("/contact/")}
    rightImage={withBase("/images/profile-portrait.jpg")}
    rightImageAlt="Atrayee portrait"
  />

  <section class="pb-14 md:pb-20">
    <div class="page-shell">
      <div>
        <p class="eyebrow">Proof it works</p>
        <h2 class="mt-3 text-4xl tracking-[-0.03em] md:text-5xl">Cited in AI Overviews. Ranking in real search results.</h2>
        <p class="mt-4 max-w-3xl text-base text-[var(--muted)] md:text-lg">
          Screenshots straight from Google Search and Search Console—showing the content actually getting found, cited, and clicked.
        </p>
      </div>
      <ProofOfWork />
    </div>
  </section>

  <section id="niche-overview" class="pb-14 md:pb-20 scroll-mt-28">
    <div class="page-shell">
      <div class="mb-8">
        <p class="eyebrow">Niche overview</p>
        <h2 class="mt-3 text-4xl tracking-[-0.03em] md:text-5xl">Built for Your Industry, Not a Template</h2>
        <p class="mt-4 max-w-3xl text-base text-[var(--muted)] md:text-lg">
          From SaaS to skincare, the audience changes—so does the approach. Explore work by industry.
        </p>
      </div>

      <NicheGrid entries={allWork} />
    </div>
  </section>

  <section class="pb-14 md:pb-20">
    <div class="page-shell">
      <div>
        <p class="eyebrow">Featured work</p>
        <h2 class="mt-3 text-5xl tracking-[-0.03em] md:text-6xl">Real projects, real results—SEO strategy meets editorial craft.</h2>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {featuredWork.length > 0 ? (
          featuredWork.map((entry) => (
            <WorkCard entry={entry} compact={true} />
          ))
        ) : (
          <article class="card-surface rounded-[1.8rem] p-8 md:col-span-2 xl:col-span-3">
            <p class="eyebrow">Portfolio refresh in progress</p>
            <h3 class="mt-3 font-['Fraunces'] text-3xl tracking-[-0.03em]">New writing samples will be added here next.</h3>
            <p class="mt-4 max-w-2xl text-base text-[var(--muted)]">
              The archive is being reset for a fresh set of articles and case-study entries. For now, the site keeps the niche structure in place so future work can be added cleanly.
            </p>
          </article>
        )}
      </div>
    </div>
  </section>

  <section class="pb-14 md:pb-20">
    <div class="page-shell">
      <div class="process-heading space-y-4">
        <p class="eyebrow">How Atrayee works</p>
        <h2 class="text-4xl tracking-[-0.03em] md:text-5xl">No Guesswork. Just a Process That Works.</h2>
      </div>

      <div class="process-steps-grid mt-8 md:mt-10">
        {siteData.howIWork.map((step, index) => {
          const palette = stepPalette[index % stepPalette.length];
          const stepNumber = String(index + 1).padStart(2, "0");

          return (
            <article
              class="process-step-card"
              style={`--step-base:${palette.base}; --step-soft:${palette.soft};`}
            >
              <div class="process-step-frame"></div>
              <div class="process-step-panel">
                <div class="process-step-badge">
                  <span class="process-step-badge-label">Step</span>
                  <span class="process-step-badge-number">{stepNumber}</span>
                </div>
                <h3 class="process-step-title">{step.title}</h3>
                <p class="process-step-copy">{step.detail}</p>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <CTASection
    eyebrow="Ready to hire?"
    title="Need writing that is strategic, readable, and actually useful to buyers?"
    primaryLabel="Get in touch"
    primaryHref={withBase("/contact/")}
    secondaryLabel="Browse work"
    secondaryHref={withBase("/work/")}
    socialLinks={[
      { label: "LinkedIn", href: siteData.linkedin, icon: "linkedin" },
      { label: "Instagram", href: siteData.instagram, icon: "instagram" },
      { label: "Email", href: `mailto:${siteData.email}`, icon: "email" }
    ]}
  />
</BaseLayout>

<script is:inline>
  const selectedNiche = new URLSearchParams(window.location.search).get("niche");
  if (selectedNiche) {
    document.querySelectorAll("[data-niche-card]").forEach((card) => {
      if (!(card instanceof HTMLElement)) return;
      card.classList.toggle("is-active", card.dataset.nicheCard === selectedNiche);
    });
  }
</script>
